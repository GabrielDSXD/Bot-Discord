{
  "name": "discord-voice-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Bot que monitora entradas e saídas de um canal de voz do Discord.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "set-avatar": "npm run build && node dist/scripts/set-bot-avatar.js",
    "test": "npm run build && node --test dist/domain/voice-transition.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.0.0",
    "dotenv": "^17.0.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
